# Copy this file to examples/node/.env and replace the sample values.
# The Node example loads .env automatically; existing environment variables win.
# Keep credentials in .env (ignored by Git), never in this tracked template.

# Required: absolute CMS URL, without the web-service path, query, or fragment.
# Include a virtual application path here if your CMS is hosted under one.
SITEFINITY_URL=https://cms.example.com

# Content web-service path relative to the CMS URL. Default: api/default.
# Content commands require this service to expose sfmeta, taxonomies, and the
# requested content type. Use the service configured in your Sitefinity backend.
SITEFINITY_SERVICE_PATH=api/default

# Optional: content language sent as sf_culture, for example en or fr.
# Leave blank to use the CMS default culture.
SITEFINITY_CULTURE=en

# Optional: Sitefinity site GUID sent as sf_site for a multisite installation.
# Leave blank to use the CMS/service default site context.
SITEFINITY_SITE_ID=

# Optional: bearer access token for a user allowed to call this web service.
# Supply only the token; the example adds the "Bearer " prefix.
# Leave blank for anonymous access. The example does not obtain or refresh tokens.
# This is not a Sitefinity web-service API key. Never put privileged tokens in
# browser/mobile bundles or commit them to Git.
SITEFINITY_TOKEN=

# Optional: full content type name for the news and item commands.
# Default: Telerik.Sitefinity.News.Model.NewsItem. Use the types command to
# discover names, including dynamic-module types; do not use an entity-set name.
SITEFINITY_TYPE=

# Required only for the search command: an existing, populated search index
# catalogue name from Sitefinity, not its display label or a URL.
SITEFINITY_SEARCH_INDEX=

# Optional: relative web-service path for search, if different from content.
# Leave blank to reuse SITEFINITY_SERVICE_PATH.
SITEFINITY_SEARCH_SERVICE_PATH=

# Optional for content; page layouts may require a registered renderer name.
# This sends X-SFRENDERER-PROXY-NAME; it does not register a renderer in the CMS.
SITEFINITY_RENDERER_NAME=

# Page command only: false requests the CMS page path with layout headers.
# Set to exactly true to use the service's Default.Model(url=@param) endpoint.
# Select the mode supported by your CMS; this is not detected automatically.
SITEFINITY_NEXT_GEN=false